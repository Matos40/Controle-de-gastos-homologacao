{
  "applyAuthorized": false,
  "computeProject": "__COMPUTE_PROJECT_ID__",
  "computeProjectNumber": "__COMPUTE_PROJECT_NUMBER__",
  "firebaseProject": "__EXPERIMENT_FIREBASE_PROJECT__",
  "region": "us-central1",
  "runtime": {
    "accountId": "raytech-ai-runtime",
    "staticKeys": false,
    "firebaseAuthRole": {
      "roleId": "raytechSmartAiAuthLookup",
      "includedPermissions": ["firebaseauth.users.get"]
    },
    "firestoreRole": {
      "roleId": "raytechSmartAiLedger",
      "databaseCondition": "resource.name == \"projects/__EXPERIMENT_FIREBASE_PROJECT__/databases/(default)\"",
      "includedPermissions": [
        "datastore.databases.get",
        "datastore.entities.get",
        "datastore.entities.list",
        "datastore.entities.create",
        "datastore.entities.update"
      ]
    },
    "secretBinding": {"name": "raytech-ai-gemini", "role": "roles/secretmanager.secretAccessor"}
  },
  "invoker": {"role": "roles/run.invoker", "principal": "raytech-ai-gateway@__COMPUTE_PROJECT_ID__.iam.gserviceaccount.com", "public": false}
}
