{
  "description": "Cloud Run v2 file-based entrypoints; workerProbe is a read-only mode of the SAME worker job, not an additional resource; no data: URLs, eval or inline JS",
  "service": {
    "command": [
      "node"
    ],
    "args": [
      "/app/experiments/smart-ai-server/cloud-run/bridge-runtime/trial-control-runtime.mjs"
    ]
  },
  "worker": {
    "command": [
      "node"
    ],
    "args": [
      "/app/experiments/smart-ai-server/cloud-run/bridge-runtime/trial-job-runtime.mjs"
    ]
  },
  "controller": {
    "command": [
      "node"
    ],
    "args": [
      "/app/experiments/smart-ai-server/cloud-run/bridge-runtime/trial-execution-approval.mjs"
    ]
  },
  "workerProbe": {
    "command": [
      "node"
    ],
    "args": [
      "/app/experiments/smart-ai-server/cloud-run/bridge-runtime/trial-auth-probe.mjs"
    ]
  }
}
