rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/migrationLab/{recordId} {
      allow get, list: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['key','ym','type','recordId','sourceId','value'])
        && request.resource.data.keys().hasAll(['key','ym','type','recordId','value'])
        && request.resource.data.recordId == recordId
        && request.resource.data.sourceId is string
        && request.resource.data.sourceId.size() > 0
        && request.resource.data.key is string
        && request.resource.data.ym is string
        && request.resource.data.type in ['expenses','cardExpenses','extraIncomes']
        && request.resource.data.value is map;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
