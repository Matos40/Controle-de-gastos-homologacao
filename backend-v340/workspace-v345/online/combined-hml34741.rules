rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
// Insert inside match /databases/{database}/documents after reviewing the
// complete live rules for overlapping matches. Never replace the live rules.
function v345Self(uid) {
  return request.auth != null && request.auth.uid == uid;
}
function v345Account(uid) {
  return /databases/$(database)/documents/raytechV345Accounts/$(uid);
}
function v345Role(uid) {
  return /databases/$(database)/documents/raytechV345Roles/$(uid);
}
function v345Active(uid) {
  return exists(v345Account(uid)) && get(v345Account(uid)).data.blocked == false;
}
function v345Operator(uid) {
  return exists(v345Role(uid)) && get(v345Role(uid)).data.active == true
    && get(v345Role(uid)).data.role in ['owner', 'admin'];
}
function v345IsOperator() {
  return request.auth != null && v345Active(request.auth.uid) && v345Operator(request.auth.uid);
}
function v345Premium(uid) {
  return v345Self(uid) && v345Active(uid)
    && (get(v345Account(uid)).data.plan == 'premium' || v345Operator(uid));
}
function v345Id(id) {
  return id is string && id.matches('[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}');
}
function v345Limits(limits) {
  return limits is map && limits.keys().hasOnly(['minute', 'day', 'month'])
    && limits.minute is int && limits.day is int && limits.month is int
    && limits.minute >= 1 && limits.minute <= limits.day
    && limits.day <= limits.month && limits.month <= 10000;
}
function v345Audit(id) {
  return /databases/$(database)/documents/raytechV345Audit/$(id);
}

match /raytechV345Accounts/{uid} {
  function valid(d) {
    return d.keys().hasOnly(['uid', 'name', 'plan', 'blocked', 'limits', 'lastAudit'])
      && d.uid == uid && d.name is string && d.name.size() > 0 && d.name.size() <= 80
      && d.plan in ['free', 'premium'] && d.blocked is bool
      && (!('limits' in d) || v345Limits(d.limits))
      && (!('lastAudit' in d) || v345Id(d.lastAudit));
  }
  allow get: if v345Self(uid) || v345IsOperator();
  allow list: if v345IsOperator() && request.query.limit <= 100;
  allow create: if v345Self(uid) && valid(request.resource.data)
    && request.resource.data.keys().hasOnly(['uid', 'name', 'plan', 'blocked'])
    && request.resource.data.plan == 'free' && request.resource.data.blocked == false;
  allow update: if v345IsOperator() && !v345Self(uid) && !exists(v345Role(uid))
    && valid(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'blocked', 'limits', 'lastAudit'])
    && !exists(v345Audit(request.resource.data.lastAudit))
    && getAfter(v345Audit(request.resource.data.lastAudit)).data.target == uid;
  allow delete: if false;
}

match /raytechV345Roles/{uid} {
  allow get: if v345Self(uid) || v345IsOperator();
  allow list, write: if false;
}

match /raytechV345Audit/{id} {
  function valid(d) {
    let before = get(v345Account(d.target)).data;
    let after = getAfter(v345Account(d.target)).data;
    return d.keys().hasOnly(['actor', 'target', 'beforePlan', 'afterPlan', 'beforeBlocked', 'afterBlocked', 'at'])
      && d.actor == request.auth.uid && d.target != d.actor && !exists(v345Role(d.target))
      && d.at == request.time && before.get('lastAudit', '') != id && after.lastAudit == id
      && d.beforePlan == before.plan && d.afterPlan == after.plan
      && d.beforeBlocked == before.blocked && d.afterBlocked == after.blocked;
  }
  allow list: if v345IsOperator() && request.query.limit <= 100;
  allow create: if v345IsOperator() && v345Id(id) && valid(request.resource.data);
  allow get, update, delete: if false;
}

match /raytechV345Usage/{uid} {
  function cap() {
    return get(v345Account(uid)).data.get('limits', {'minute': 3, 'day': 20, 'month': 100});
  }
  function valid(d) {
    return d.keys().hasOnly(['at', 'minute', 'day', 'month']) && d.at == request.time
      && d.minute is int && d.minute >= 1 && d.minute <= cap().minute
      && d.day is int && d.day >= 1 && d.day <= cap().day
      && d.month is int && d.month >= 1 && d.month <= cap().month;
  }
  function next(d, p) {
    let ms = d.at.toMillis();
    let prior = p.at.toMillis();
    return d.minute == (ms - ms % 60000 == prior - prior % 60000 ? p.minute + 1 : 1)
      && d.day == (ms - ms % 86400000 == prior - prior % 86400000 ? p.day + 1 : 1)
      && d.month == (d.at.year() == p.at.year() && d.at.month() == p.at.month() ? p.month + 1 : 1);
  }
  allow get: if v345Premium(uid) || v345IsOperator();
  allow create: if v345Premium(uid) && valid(request.resource.data)
    && request.resource.data.minute == 1 && request.resource.data.day == 1 && request.resource.data.month == 1;
  allow update: if v345Premium(uid) && valid(request.resource.data) && next(request.resource.data, resource.data);
  allow list, delete: if false;
}

match /raytechV345Finance/{uid}/banks/v2-main {
  function headPath() {
    return /databases/$(database)/documents/raytechV345Finance/$(uid)/banks/v2-main;
  }
  function receiptPath(id) {
    return /databases/$(database)/documents/raytechV345Finance/$(uid)/banks/v2-main/receipts/$(id);
  }
  function valid(d, revision, parentId) {
    let id = d.lastOperationId;
    let receipt = getAfter(receiptPath(id)).data;
    return d.keys().hasOnly(['marker', 'revision', 'lastOperationId', 'hash', 'payload'])
      && d.marker == 'raytech-financial-production-v2'
      && d.payload is string && d.payload.size() <= 180000
      && d.revision is int && d.revision == revision && revision <= 9007199254740991
      && d.hash is string && d.hash.matches('[0-9a-f]{64}')
      && v345Id(id) && id != parentId && !exists(receiptPath(id))
      && receipt.operationId == id && receipt.parentId == parentId
      && receipt.revision == revision && receipt.hash == d.hash;
  }
  allow get: if v345Premium(uid);
  allow create: if v345Premium(uid) && valid(request.resource.data, 1, '');
  allow update: if v345Premium(uid)
    && valid(request.resource.data, resource.data.revision + 1, resource.data.lastOperationId);
  allow delete, list: if false;

  match /receipts/{id} {
    function validReceipt(d) {
      let next = getAfter(headPath()).data;
      return d.keys().hasOnly(['operationId', 'parentId', 'revision', 'hash'])
        && d.operationId == id && v345Id(id) && next.lastOperationId == id
        && d.revision == next.revision && d.hash == next.hash
        && (exists(headPath())
          ? d.parentId == get(headPath()).data.lastOperationId && d.revision == get(headPath()).data.revision + 1
          : d.revision == 1 && d.parentId == '');
    }
    allow get: if v345Premium(uid);
    allow create: if v345Premium(uid) && validReceipt(request.resource.data);
    allow list, update, delete: if false;
  }
}


    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    }
    // INSERIR DENTRO de match /databases/{database}/documents, preservando as demais regras.
    // Antes de publicar, verificar que nenhuma regra recursiva/permissiva concede acesso a estas duas coleções.
    // Somente para o projeto raytech-cg-homologacao; NÃO usar na produção.
    match /raytechSyncPilotAccessV1/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /raytechSyncPilotV1/{uid} {
      function approved() {
        return request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid))
          && get(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid)).data.enabled == true;
      }
      function valid(d) {
        return d.keys().hasAll(['marker', 'revision', 'receipts', 'lastOperationId', 'salary', 'energy', 'food', 'card', 'extra', 'energyPaid', 'foodPaid', 'cardPaid'])
          && d.keys().hasOnly(['marker', 'revision', 'receipts', 'lastOperationId', 'salary', 'energy', 'food', 'card', 'extra', 'energyPaid', 'foodPaid', 'cardPaid'])
          && d.marker == 'raytech-synthetic-financial-pilot-v1'
          && d.revision is int && d.revision >= 1 && d.revision <= 100
          && d.receipts is map && d.receipts.keys().size() == d.revision
          && d.lastOperationId is string
          && d.lastOperationId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          && d.receipts.keys().hasAny([d.lastOperationId])
          && d.receipts[d.lastOperationId] is string
          && d.receipts[d.lastOperationId].size() <= 80
          && d.receipts[d.lastOperationId].matches('^(salary|energy|food|card|extra|energyPaid|foodPaid|cardPaid):(true|false|[0-9]+):[0-9]+$')
          && d.salary is int && d.salary in [0, 400000, 500000, 550000]
          && d.energy is int && d.energy in [0, 15000, 18000, 21000]
          && d.energyPaid is bool && (d.energy != 0 || d.energyPaid == false)
          && d.food is int && d.food in [0, 25000, 30000, 35000]
          && d.foodPaid is bool && (d.food != 0 || d.foodPaid == false)
          && d.card is int && d.card in [0, 10000, 20000, 30000]
          && d.cardPaid is bool && (d.card != 0 || d.cardPaid == false)
          && d.extra is int && d.extra in [0, 10000, 25000, 50000];
      }
      allow get: if approved();
      allow list, delete: if false;
      allow create: if approved() && valid(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.receipts.keys().hasOnly([request.resource.data.lastOperationId]);
      allow update: if approved() && valid(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && !resource.data.receipts.keys().hasAny([request.resource.data.lastOperationId])
        && request.resource.data.receipts.diff(resource.data.receipts).addedKeys().hasOnly([request.resource.data.lastOperationId])
        && request.resource.data.receipts.diff(resource.data.receipts).affectedKeys().hasOnly([request.resource.data.lastOperationId]);
    }
    

    // Adicionar dentro de match /databases/{database}/documents. Não substituir as regras existentes.
    match /raytechFinancialTestV1/{uid} {
      function approved() {
        return request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid))
          && get(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid)).data.enabled == true;
      }
      function valid(d) {
        return d.keys().hasAll(['marker','revision','payload','receipts','lastOperationId'])
          && d.keys().hasOnly(['marker','revision','payload','receipts','lastOperationId'])
          && d.marker == 'raytech-financial-test-v1'
          && d.revision is int && d.revision >= 1 && d.revision <= 500
          && d.payload is string && d.payload.size() <= 180000
          && d.receipts is map && d.receipts.keys().size() == d.revision
          && d.lastOperationId is string
          && d.lastOperationId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          && d.receipts.keys().hasAny([d.lastOperationId])
          && d.receipts[d.lastOperationId] is string
          && d.receipts[d.lastOperationId].matches('^[1-9][0-9]{0,2}:[0-9a-f]{64}$');
      }
      allow get: if approved();
      allow list, delete: if false;
      allow create: if approved() && !existsAfter(/databases/$(database)/documents/raytechFinancialRouteV2/$(uid)) && valid(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.receipts.keys().hasOnly([request.resource.data.lastOperationId]);
      allow update: if approved() && !existsAfter(/databases/$(database)/documents/raytechFinancialRouteV2/$(uid)) && valid(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && !resource.data.receipts.keys().hasAny([request.resource.data.lastOperationId])
        && request.resource.data.receipts.diff(resource.data.receipts).addedKeys().hasOnly([request.resource.data.lastOperationId])
        && request.resource.data.receipts.diff(resource.data.receipts).affectedKeys().hasOnly([request.resource.data.lastOperationId]);
    }
    

    // Adicionar exclusivamente ao projeto raytech-cg-homologacao, junto das regras existentes.
    // Protocolo separado: não altera V1 nem /users. Não publicar na produção.
    match /raytechFinancialTestV2/{uid} {
      function approved() {
        return request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid))
          && get(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid)).data.enabled == true;
      }
      function uuid(x) { return x is string && x.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'); }
      function validHash(x) { return x is string && x.matches('^[0-9a-f]{64}$'); }
      function validHead(h) {
        return h.keys().hasAll(['marker','revision','payload','lastOperationId','hash'])
          && h.keys().hasOnly(['marker','revision','payload','lastOperationId','hash'])
          && h.marker == 'raytech-financial-test-v2'
          && h.revision is int && h.revision >= 1 && h.revision <= 9007199254740991
          && h.payload is string && h.payload.size() <= 180000
          && uuid(h.lastOperationId) && validHash(h.hash);
      }
      function validReceipt(r, op) {
        return r.keys().hasAll(['operationId','revision','parentId','hash'])
          && r.keys().hasOnly(['operationId','revision','parentId','hash'])
          && uuid(op) && r.operationId == op
          && r.revision is int && r.revision >= 1 && r.revision <= 9007199254740991
          && ((r.revision == 1 && r.parentId == '') || (r.revision > 1 && uuid(r.parentId) && r.parentId != op))
          && validHash(r.hash);
      }
      function paired(h, parent) {
        let p = /databases/$(database)/documents/raytechFinancialTestV2/$(uid)/receipts/$(h.lastOperationId);
        let r = getAfter(p).data;
        return !exists(p) && existsAfter(p) && validReceipt(r,h.lastOperationId)
          && r.revision == h.revision && r.parentId == parent && r.hash == h.hash;
      }
      allow get: if approved();
      allow list, delete: if false;
      allow create: if approved() && validHead(request.resource.data) && request.resource.data.revision == 1 && paired(request.resource.data,'');
      allow update: if approved() && validHead(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && paired(request.resource.data,resource.data.lastOperationId);
      match /receipts/{op} {
        function pairedHead(r) {
          let p = /databases/$(database)/documents/raytechFinancialTestV2/$(uid);
          let h = getAfter(p).data;
          return existsAfter(p) && validHead(h) && h.lastOperationId == op && h.revision == r.revision && h.hash == r.hash
            && ((!exists(p) && r.revision == 1 && r.parentId == '') ||
                (exists(p) && r.revision == get(p).data.revision + 1 && r.parentId == get(p).data.lastOperationId));
        }
        allow get: if approved();
        allow create: if approved() && validReceipt(request.resource.data,op) && pairedHead(request.resource.data);
        allow list, update, delete: if false;
      }
    }
    

    // Adicionar exclusivamente ao projeto raytech-cg-homologacao, junto das regras existentes.
    // Protocolo separado: não altera V1 nem /users. Não publicar na produção.
    match /raytechFinancialActiveV2/{uid} {
      function approved() {
        return request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid))
          && get(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid)).data.enabled == true;
      }
      function uuid(x) { return x is string && x.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'); }
      function validHash(x) { return x is string && x.matches('^[0-9a-f]{64}$'); }
      function validHead(h) {
        return h.keys().hasAll(['marker','revision','payload','lastOperationId','hash'])
          && h.keys().hasOnly(['marker','revision','payload','lastOperationId','hash'])
          && h.marker == 'raytech-financial-test-v2'
          && h.revision is int && h.revision >= 1 && h.revision <= 9007199254740991
          && h.payload is string && h.payload.size() <= 180000
          && uuid(h.lastOperationId) && validHash(h.hash);
      }
      function validReceipt(r, op) {
        return r.keys().hasAll(['operationId','revision','parentId','hash'])
          && r.keys().hasOnly(['operationId','revision','parentId','hash'])
          && uuid(op) && r.operationId == op
          && r.revision is int && r.revision >= 1 && r.revision <= 9007199254740991
          && ((r.revision == 1 && r.parentId == '') || (r.revision > 1 && uuid(r.parentId) && r.parentId != op))
          && validHash(r.hash);
      }
      function paired(h, parent) {
        let p = /databases/$(database)/documents/raytechFinancialActiveV2/$(uid)/receipts/$(h.lastOperationId);
        let r = getAfter(p).data;
        return !exists(p) && existsAfter(p) && validReceipt(r,h.lastOperationId)
          && r.revision == h.revision && r.parentId == parent && r.hash == h.hash;
      }
      allow get: if approved();
      allow list, delete: if false;
      function activeAfter() { return existsAfter(/databases/$(database)/documents/raytechFinancialRouteV2/$(uid)); }
      allow create: if approved() && activeAfter() && validHead(request.resource.data) && request.resource.data.revision == 1 && paired(request.resource.data,'');
      allow update: if approved() && activeAfter() && validHead(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && paired(request.resource.data,resource.data.lastOperationId);
      match /receipts/{op} {
        function pairedHead(r) {
          let p = /databases/$(database)/documents/raytechFinancialActiveV2/$(uid);
          let h = getAfter(p).data;
          return existsAfter(p) && validHead(h) && h.lastOperationId == op && h.revision == r.revision && h.hash == r.hash
            && ((!exists(p) && r.revision == 1 && r.parentId == '') ||
                (exists(p) && r.revision == get(p).data.revision + 1 && r.parentId == get(p).data.lastOperationId));
        }
        allow get: if approved();
        allow create: if approved() && activeAfter() && validReceipt(request.resource.data,op) && pairedHead(request.resource.data);
        allow list, update, delete: if false;
      }
    }
    

    match /raytechFinancialRouteV2/{uid} {
      function approved() {
        return request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid))
          && get(/databases/$(database)/documents/raytechSyncPilotAccessV1/$(uid)).data.enabled == true;
      }
      function validRoute(d) {
        let p = /databases/$(database)/documents/raytechFinancialTestV1/$(uid);
        let h = /databases/$(database)/documents/raytechFinancialActiveV2/$(uid);
        let v = get(p).data;
        let n = getAfter(h).data;
        return exists(p) && existsAfter(h) && d.keys().hasAll(['sourceRevision','sourceLast','seed','hash'])
          && d.keys().hasOnly(['sourceRevision','sourceLast','seed','hash'])
          && d.sourceRevision == v.revision && d.sourceLast == v.lastOperationId
          && d.hash is string && d.hash.matches('^[0-9a-f]{64}$')
          && v.receipts[v.lastOperationId].matches('^[1-9][0-9]{0,2}:' + d.hash + '$')
          && n.revision == 1 && n.lastOperationId == d.seed && n.payload == v.payload && n.hash == d.hash;
      }
      function unchangedSeed() {
        let p = /databases/$(database)/documents/raytechFinancialTestV1/$(uid);
        let h = /databases/$(database)/documents/raytechFinancialActiveV2/$(uid);
        let v = get(p).data;
        let n = getAfter(h).data;
        return exists(p) && existsAfter(h) && n.revision == 1 && n.lastOperationId == resource.data.seed
          && n.hash == resource.data.hash && n.payload == v.payload
          && v.revision == resource.data.sourceRevision && v.lastOperationId == resource.data.sourceLast;
      }
      allow get: if approved();
      allow create: if approved() && validRoute(request.resource.data);
      allow delete: if approved() && unchangedSeed();
      allow list, update: if false;
    }
    // Smart Sync V32.6 - exclusivamente homologacao.
    match /raytechSmart326AccessV1/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /raytechSmart326FinanceV1/{uid} {
      function approved() {
        return request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/raytechSmart326AccessV1/$(uid))
          && get(/databases/$(database)/documents/raytechSmart326AccessV1/$(uid)).data.enabled == true;
      }
      function writable() { return approved() && get(/databases/$(database)/documents/raytechSmart326AccessV1/$(uid)).data.writeEnabled == true; }
      function uuid(x) { return x is string && x.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'); }
      function validHash(x) { return x is string && x.matches('^[0-9a-f]{64}$'); }
      function validHead(h) {
        return h.keys().hasAll(['marker','revision','payload','lastOperationId','hash'])
          && h.keys().hasOnly(['marker','revision','payload','lastOperationId','hash'])
          && h.marker == 'raytech-financial-smart-hml-v326'
          && h.revision is int && h.revision >= 1 && h.revision <= 9007199254740991
          && h.payload is string && h.payload.size() <= 180000
          && uuid(h.lastOperationId) && validHash(h.hash);
      }
      function validReceipt(r, op) {
        return r.keys().hasAll(['operationId','revision','parentId','hash'])
          && r.keys().hasOnly(['operationId','revision','parentId','hash'])
          && uuid(op) && r.operationId == op
          && r.revision is int && r.revision >= 1 && r.revision <= 9007199254740991
          && ((r.revision == 1 && r.parentId == '') || (r.revision > 1 && uuid(r.parentId) && r.parentId != op))
          && validHash(r.hash);
      }
      function paired(h, parent) {
        let p = /databases/$(database)/documents/raytechSmart326FinanceV1/$(uid)/receipts/$(h.lastOperationId);
        let r = getAfter(p).data;
        return !exists(p) && existsAfter(p) && validReceipt(r,h.lastOperationId)
          && r.revision == h.revision && r.parentId == parent && r.hash == h.hash;
      }
      allow get: if approved();
      allow list, delete: if false;
      allow create: if writable() && validHead(request.resource.data) && request.resource.data.revision == 1 && paired(request.resource.data,'');
      allow update: if writable() && validHead(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && paired(request.resource.data,resource.data.lastOperationId);
      match /receipts/{op} {
        function pairedHead(r) {
          let p = /databases/$(database)/documents/raytechSmart326FinanceV1/$(uid);
          let h = getAfter(p).data;
          return existsAfter(p) && validHead(h) && h.lastOperationId == op && h.revision == r.revision && h.hash == r.hash
            && ((!exists(p) && r.revision == 1 && r.parentId == '') ||
                (exists(p) && r.revision == get(p).data.revision + 1 && r.parentId == get(p).data.lastOperationId));
        }
        allow get: if approved();
        allow create: if writable() && validReceipt(request.resource.data,op) && pairedHead(request.resource.data);
        allow list, update, delete: if false;
      }
    }

