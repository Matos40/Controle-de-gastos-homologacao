      }
      allow get: if self() || smart333Operator();
      allow list: if smart333Operator() && request.query.limit <= 100;
      allow create: if self() && request.resource.data.keys().hasOnly(['uid','plan','blocked','createdAt','lastAccess','email','name','photo'])
